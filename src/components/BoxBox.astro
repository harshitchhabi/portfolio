---
const email = 'harshitchhabi@gmail.com';
---

<section id="box-box" class="section wrap" aria-labelledby="bb-title">
  <h2 id="bb-title" class="display bb">Box box.</h2>
  <ul class="contact">
    <li>
      <span class="label">Email</span>
      <a href={`mailto:${email}`} data-copy={email}>{email}</a>
      <span class="copied" data-copied aria-live="polite"></span>
    </li>
    <li>
      <span class="label">LinkedIn</span>
      <a href="https://www.linkedin.com/in/harshit-chhabi-6007b4368" rel="noopener">linkedin.com/in/harshit-chhabi-6007b4368 ↗</a>
    </li>
    <li>
      <span class="label">GitHub</span>
      <a href="https://github.com/harshitchhabi" rel="noopener">github.com/harshitchhabi ↗</a>
    </li>
    <li>
      <span class="label">Resume</span>
      <a href="/resume.pdf">resume.pdf ↓</a>
    </li>
  </ul>
</section>

<style>
  .bb {
    font-size: clamp(64px, 16vw, 280px);
    margin-left: -0.04em;
  }

  .contact {
    margin-top: clamp(32px, 4vw, 56px);
    border-top: 1px solid var(--text);
    font-family: var(--font-mono);
    font-size: clamp(14px, 1.3vw, 18px);
  }

  .contact li {
    display: grid;
    grid-template-columns: minmax(10ch, 2fr) 10fr;
    gap: 8px 24px;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .contact a {
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--t-fast) linear;
  }

  .contact a:hover {
    color: var(--timing);
  }

  .copied {
    grid-column: 2;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--timing);
  }

  .copied:empty {
    display: none;
  }

  @media (max-width: 640px) {
    .contact li {
      grid-template-columns: 1fr;
    }

    .copied {
      grid-column: 1;
    }
  }
</style>
