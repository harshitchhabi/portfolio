---
// A handwritten margin note with a hand-drawn arrow pointing at something.
// The arrow draws itself when it scrolls into view.
import { roughArrow } from '../../lib/rough';

interface Props {
  arrow?: 'left' | 'right' | 'down' | 'up' | 'none';
  color?: 'pink' | 'green' | 'ink';
  seed?: number;
  class?: string;
}
const { arrow = 'left', color = 'pink', seed = 4, class: cls } = Astro.props;
const paths: Record<string, [number, number][]> = {
  left: [[92, 20], [56, 6], [8, 14]],
  right: [[8, 20], [44, 6], [92, 14]],
  down: [[20, 4], [8, 40], [22, 74]],
  up: [[20, 74], [8, 40], [22, 6]],
};
const svg = arrow === 'none' ? '' : roughArrow(paths[arrow], { seed, strokeWidth: 1.8, roughness: 1.4 });
const vertical = arrow === 'down' || arrow === 'up';
---

<p class:list={['note', 'hand', `note-${color}`, `note-${arrow}`, cls]}>
  {
    arrow !== 'none' && (
      <svg class="note-arrow draw" viewBox={vertical ? '0 0 30 80' : '0 0 100 28'} width={vertical ? 30 : 100} height={vertical ? 80 : 28} aria-hidden="true" set:html={svg} />
    )
  }
  <span><slot /></span>
</p>

<style>
  .note {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: clamp(19px, 1.6vw, 24px);
    max-width: 22ch;
    line-height: 1.1;
  }

  .note-pink {
    color: var(--riso-pink);
  }
  .note-green {
    color: var(--riso-green);
  }
  .note-ink {
    color: var(--ink);
  }

  .note-right {
    flex-direction: row-reverse;
  }

  .note-down,
  .note-up {
    flex-direction: column;
    align-items: flex-start;
  }

  .note-up {
    flex-direction: column-reverse;
  }

  .note-arrow {
    flex: none;
  }
</style>
