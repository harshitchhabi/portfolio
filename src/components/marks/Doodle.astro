---
// Margin doodles: circuit traces, a cable squiggle, a little wifi fan, a plug.
import { roughBox, roughCircle, roughCurve, roughLine } from '../../lib/rough';

interface Props {
  kind: 'circuit' | 'cable' | 'signal' | 'plug';
  seed?: number;
  class?: string;
  color?: 'dim' | 'pink' | 'green';
}
const { kind, seed = 2, class: cls, color = 'dim' } = Astro.props;
const o = { seed, strokeWidth: 1.4, roughness: 1.3 };
let svg = '';
let vb = '0 0 160 120';
if (kind === 'circuit') {
  svg =
    roughLine(4, 20, 70, 20, o) + roughLine(70, 20, 90, 40, o) + roughLine(90, 40, 150, 40, o) + roughCircle(150, 40, 8, o) +
    roughLine(4, 60, 50, 60, o) + roughLine(50, 60, 70, 80, o) + roughLine(70, 80, 120, 80, o) + roughCircle(124, 80, 8, o) +
    roughLine(30, 60, 30, 104, o) + roughBox(60, 92, 30, 22, o) + roughCircle(4, 20, 6, o) + roughCircle(4, 60, 6, o);
} else if (kind === 'cable') {
  vb = '0 0 200 80';
  svg = roughCurve([[2, 40], [30, 10], [60, 60], [90, 20], [120, 70], [150, 30], [196, 46]], { ...o, strokeWidth: 2.2 }) +
    roughCurve([[2, 50], [32, 22], [62, 70], [92, 30], [122, 78], [152, 40], [196, 54]], { ...o, seed: seed + 5 });
} else if (kind === 'signal') {
  vb = '0 0 100 90';
  svg = roughCircle(50, 80, 8, o) +
    [24, 44, 64].map((d, i) => roughCurve([[50 - d / 1.4, 80 - d / 1.4], [50, 80 - d], [50 + d / 1.4, 80 - d / 1.4]], { ...o, seed: seed + i })).join('');
} else {
  vb = '0 0 120 70';
  svg = roughBox(40, 18, 44, 34, o) + roughLine(84, 26, 112, 26, o) + roughLine(84, 44, 112, 44, o) + roughCurve([[40, 35], [20, 30], [10, 50], [2, 60]], o);
}
---

<svg class:list={['doodle', `doodle-${color}`, cls]} viewBox={vb} aria-hidden="true" set:html={svg} />

<style>
  .doodle {
    position: absolute;
    pointer-events: none;
    width: 140px;
    height: auto;
    overflow: visible;
  }
  .doodle-dim {
    color: var(--ink-dim);
    opacity: 0.6;
  }
  .doodle-pink {
    color: var(--riso-pink);
  }
  .doodle-green {
    color: var(--riso-green);
  }
</style>
