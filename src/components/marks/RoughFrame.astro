---
// A hand-drawn border that stretches with its box. The SVG is generated at
// build time; preserveAspectRatio="none" lets it follow the content size.
import { roughRect } from '../../lib/rough';

interface Props {
  seed?: number;
  w?: number;
  h?: number;
  class?: string;
}
const { seed = 1, w = 600, h = 360, class: cls } = Astro.props;
const svg = roughRect(w, h, { seed });
---

<div class:list={['frame', cls]}>
  <svg class="frame-line" viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="none" aria-hidden="true" set:html={svg} />
  <slot />
</div>

<style>
  .frame {
    position: relative;
    padding: clamp(20px, 3vw, 36px);
  }

  .frame-line {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    pointer-events: none;
    overflow: visible;
  }

  .frame-line :global(path) {
    vector-effect: non-scaling-stroke;
  }
</style>
