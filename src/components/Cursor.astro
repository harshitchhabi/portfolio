---
// The custom cursor's shapes, drawn at build time (three boil frames each).
// Hidden until scripts/cursor.ts switches it on; the native cursor stays
// in charge if that script never runs.
import { roughCircle, roughLine, roughCurve } from '../lib/rough';

const frames = [0, 1, 2];
const o = (f: number, extra = {}) => ({ seed: 101 + f * 13, strokeWidth: 1.6, roughness: 1.3, ...extra });
const probe = (f: number) =>
  roughCircle(20, 20, 18, o(f)) + roughLine(20, 0, 20, 10, o(f)) + roughLine(20, 30, 20, 40, o(f)) + roughLine(0, 20, 10, 20, o(f)) + roughLine(30, 20, 40, 20, o(f));
const glass = (f: number) => roughCircle(18, 18, 26, o(f, { strokeWidth: 2 })) + roughLine(27, 27, 40, 40, o(f, { strokeWidth: 3.2 }));
const pick = (f: number) => roughLine(4, 36, 30, 10, o(f, { strokeWidth: 2 })) + roughCurve([[30, 10], [36, 6], [38, 12], [33, 14]], o(f, { strokeWidth: 2 })) + roughLine(4, 36, 10, 30, o(f, { strokeWidth: 4 }));
---

<div class="cursor" aria-hidden="true" hidden data-cursor-root>
  <svg class="trail" data-trail><path></path></svg>
  <div class="tip" data-tip>
    {
      (['probe', 'glass', 'pick'] as const).map((k) => (
        <span class={`shape shape-${k}`} data-shape={k}>
          {frames.map((f) => (
            <svg viewBox="0 0 42 42" width="42" height="42" set:html={k === 'probe' ? probe(f) : k === 'glass' ? glass(f) : pick(f)} />
          ))}
        </span>
      ))
    }
    <span class="inspect hand">inspect</span>
  </div>
</div>

<style>
  .cursor {
    position: fixed;
    inset: 0;
    z-index: 95;
    pointer-events: none;
    /* white ink on black paper, dark ink on the cream pages (logbook, log, shell) */
    mix-blend-mode: difference;
  }

  .cursor[hidden] {
    display: none;
  }

  .trail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .trail path {
    fill: var(--ink);
    opacity: 0.55;
  }

  .tip {
    position: absolute;
    left: 0;
    top: 0;
    color: var(--ink);
    will-change: transform;
  }

  .shape {
    display: none;
    position: absolute;
    left: -21px;
    top: -21px;
  }

  .shape svg {
    position: absolute;
    left: 0;
    top: 0;
    visibility: hidden;
    overflow: visible;
  }

  .shape svg:nth-child(1) {
    visibility: visible;
  }

  .cursor[data-frame='1'] .shape svg:nth-child(1),
  .cursor[data-frame='2'] .shape svg:nth-child(1) {
    visibility: hidden;
  }
  .cursor[data-frame='1'] .shape svg:nth-child(2),
  .cursor[data-frame='2'] .shape svg:nth-child(3) {
    visibility: visible;
  }

  .cursor[data-kind='probe'] .shape-probe,
  .cursor[data-kind='glass'] .shape-glass,
  .cursor[data-kind='pick'] .shape-pick {
    display: block;
  }

  .shape-glass,
  .shape-pick {
    left: -8px;
    top: -8px;
  }

  .inspect {
    display: none;
    position: absolute;
    left: 30px;
    top: 22px;
    font-size: 20px;
    color: var(--riso-pink);
    white-space: nowrap;
  }

  .cursor[data-kind='glass'] .inspect {
    display: block;
  }

  .cursor[data-kind='none'] .tip {
    display: none;
  }

  /* Only while the custom cursor is actually running. */
  :global(html.has-cursor),
  :global(html.has-cursor a),
  :global(html.has-cursor button) {
    cursor: none;
  }

  :global(html.has-cursor input),
  :global(html.has-cursor textarea) {
    cursor: text;
  }
</style>
