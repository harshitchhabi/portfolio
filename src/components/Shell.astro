---
import { getProjects } from '../lib/projects';
import Tape from './marks/Tape.astro';

const projects = (await getProjects()).map((p) => ({
  daemon: p.data.daemon,
  pid: p.data.pid,
  slug: p.data.slug,
  title: p.data.title,
}));
---

<div class="shell" role="dialog" aria-modal="true" aria-labelledby="shell-title" hidden data-shell data-lenis-prevent data-projects={JSON.stringify(projects)}>
  <Tape class="sh-t1" seed={131} />
  <Tape class="sh-t2" seed={137} w={90} />
  <div class="shell-bar">
    <p id="shell-title" class="label">~ harshit@daemons · type help</p>
    <button type="button" class="shell-close label" data-shell-close aria-label="Close shell">Esc ×</button>
  </div>
  <div class="shell-out" role="log" aria-live="polite" aria-relevant="additions" data-shell-out></div>
  <form class="shell-in" data-shell-form autocomplete="off">
    <label for="shell-input" class="prompt">$</label>
    <input
      id="shell-input"
      type="text"
      spellcheck="false"
      autocapitalize="off"
      autocomplete="off"
      enterkeyhint="send"
      aria-describedby="shell-title"
      data-shell-input
    />
  </form>
</div>

<style>
  /* a scrap of paper taped to the bottom of the screen */
  .shell {
    position: fixed;
    left: var(--margin);
    right: var(--margin);
    bottom: 0;
    z-index: 60;
    max-width: 860px;
    margin-inline: auto;
    height: min(52vh, 440px);
    display: grid;
    grid-template-rows: auto 1fr auto;
    background: #f2eee4;
    color: #1d1813;
    font-family: var(--font-mono);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    rotate: -0.6deg;
    clip-path: polygon(0 3%, 6% 0, 14% 2.4%, 23% 0.4%, 33% 2.6%, 44% 0.2%, 55% 2.2%, 66% 0, 77% 2.6%, 88% 0.6%, 100% 2.2%, 100% 100%, 0 100%);
  }

  .shell[hidden] {
    display: none;
  }

  .shell :global(.sh-t1) {
    top: 2px;
    left: 30px;
    rotate: -4deg;
  }

  .shell :global(.sh-t2) {
    top: 4px;
    right: 40px;
    rotate: 5deg;
  }

  .shell-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 18px 8px;
    border-bottom: 1px dashed rgba(29, 24, 19, 0.35);
  }

  .shell-bar .label {
    color: #5b5249;
  }

  .shell-close {
    color: #5b5249;
  }

  .shell-close:hover {
    color: #a3004f;
  }

  /* more above the prompt than fits: fade the bottom edge (lib/more.ts) */
  .shell-out::after {
    content: '';
    position: sticky;
    bottom: -12px;
    display: block;
    height: 34px;
    margin: -34px -18px -12px;
    background: linear-gradient(rgba(242, 238, 228, 0), #f2eee4 85%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms linear;
  }

  .shell-out[data-more]::after {
    opacity: 1;
  }

  .shell-out {
    overflow-y: auto;
    padding: 12px 18px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    line-height: 1.6;
    background-image: repeating-linear-gradient(to bottom, transparent 0 21px, rgba(29, 24, 19, 0.08) 21px 22px);
  }

  .shell-out :global(.cmd) {
    color: #5b5249;
  }

  .shell-out :global(.ok) {
    color: #006b3a;
  }

  .shell-out :global(.bad) {
    color: #a3004f;
  }

  .shell-out :global(.dim) {
    color: #5b5249;
  }

  .shell-in {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 10px 18px 16px;
    border-top: 1px dashed rgba(29, 24, 19, 0.35);
  }

  .prompt {
    color: #a3004f;
  }

  .shell-in input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    color: #1d1813;
    font: inherit;
    font-size: 16px;
    padding: 4px 0;
    outline: none;
    caret-color: #a3004f;
  }

  .shell-in {
    border-bottom: 2px solid transparent;
  }

  .shell-in:focus-within {
    border-bottom-color: #a3004f;
  }
</style>
