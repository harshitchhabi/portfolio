---
import { getProjects } from '../lib/projects';

const projects = (await getProjects()).map((p) => ({
  daemon: p.data.daemon,
  pid: p.data.pid,
  slug: p.data.slug,
  title: p.data.title,
}));
---

<div class="shell" role="dialog" aria-modal="true" aria-labelledby="shell-title" hidden data-shell data-projects={JSON.stringify(projects)}>
  <div class="shell-bar">
    <p id="shell-title" class="label">~ harshit@daemons · type help</p>
    <button type="button" class="shell-close label" data-shell-close aria-label="Close shell">Esc ×</button>
  </div>
  <div class="shell-out" role="log" aria-live="polite" aria-relevant="additions" data-shell-out></div>
  <form class="shell-in" data-shell-form autocomplete="off">
    <label for="shell-input" class="prompt">$</label>
    <input
      id="shell-input"
      type="text"
      spellcheck="false"
      autocapitalize="off"
      autocomplete="off"
      enterkeyhint="send"
      aria-describedby="shell-title"
      data-shell-input
    />
  </form>
</div>

<style>
  .shell {
    position: fixed;
    left: var(--margin);
    right: var(--margin);
    bottom: 0;
    z-index: 60;
    max-width: 920px;
    margin-inline: auto;
    height: min(52vh, 460px);
    display: grid;
    grid-template-rows: auto 1fr auto;
    background: var(--paper-2);
    border: 1px solid var(--ink);
    border-bottom: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .shell[hidden] {
    display: none;
  }

  .shell-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 14px;
    border-bottom: 1px solid var(--ink-dim);
  }

  .shell-close:hover {
    color: var(--ink);
  }

  .shell-out {
    overflow-y: auto;
    padding: 12px 14px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    line-height: 1.6;
  }

  .shell-out :global(.cmd) {
    color: var(--ink-dim);
  }

  .shell-out :global(.ok) {
    color: var(--riso-green);
  }

  .shell-out :global(.bad) {
    color: var(--riso-pink);
  }

  .shell-out :global(.dim) {
    color: var(--ink-dim);
  }

  .shell-in {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 10px 14px 14px;
    border-top: 1px solid var(--ink-dim);
  }

  .prompt {
    color: var(--riso-pink);
  }

  .shell-in input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    color: var(--ink);
    font: inherit;
    font-size: 16px;
    padding: 4px 0;
    outline: none;
    caret-color: var(--riso-pink);
  }

  .shell-in:focus-within {
    border-bottom: 2px solid var(--riso-pink);
    padding-bottom: 12px;
  }
</style>
