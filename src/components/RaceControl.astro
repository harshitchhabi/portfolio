---
import feed from '../data/race-control.json';

type Kind = 'incident' | 'investigation' | 'decision' | 'resolved';
const events = feed.events as { time: string; kind: Kind; message: string; outcome: string }[];
const live = feed.source !== 'sample';
const header = live ? 'Replayed feed · anonymised Cowrie log' : 'Simulated feed · sample events';
---

<section id="race-control" class="section wrap" aria-labelledby="rc-title">
  <div class="section-head">
    <h2 id="rc-title" class="display section-title">Race control</h2>
    <p class="label flag">{header}</p>
  </div>

  <div class="rc grid">
    <ol class="feed" data-feed aria-label={`Race control messages, ${header.toLowerCase()}, newest first`}>
      {
        events.map((e) => (
          <li class:list={['msg', `k-${e.kind}`]} data-feed-row>
            <time class="t">{e.time}</time>
            <span class="kind">{e.kind}</span>
            <span class="text">{e.message}</span>
            <span class:list={['outcome', { ok: e.outcome !== 'NOTED' }]}>{e.outcome}</span>
          </li>
        ))
      }
    </ol>

    <div class="rc-note">
      <p class="label">Where these come from</p>
      <p>
        These messages are the kind of thing the Cowrie SSH honeypot in my <a href="/projects/ids">IDS project</a> logs:
        brute-force runs, scans, a decoy login and whatever the attacker tries next.
      </p>
      <p>
        The catch my research found: if you auto-label everything this feed sees as malicious and retrain on it, the
        attacker gets to write your training data. The same feed can poison the IDS.
      </p>
      <a class="link-mono" href="/projects/ids">Read the IDS case study →</a>
    </div>
  </div>
</section>

<style>
  .flag {
    color: var(--timing);
    border: 1px solid currentColor;
    padding: 4px 8px;
  }

  .rc {
    row-gap: 40px;
  }

  .feed {
    grid-column: 1 / span 8;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-top: 1px solid var(--line);
  }

  .msg {
    display: grid;
    grid-template-columns: 9ch 15ch 1fr auto;
    gap: 16px;
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .t {
    color: var(--muted);
  }

  .kind {
    font-weight: 700;
  }

  .k-incident .kind {
    color: var(--red);
  }

  .k-investigation .kind {
    color: var(--timing);
  }

  .k-decision .kind,
  .k-resolved .kind {
    color: var(--green);
  }

  .outcome {
    color: var(--muted);
  }

  .outcome.ok {
    color: var(--green);
  }

  .rc-note {
    grid-column: 10 / span 3;
    display: grid;
    gap: 16px;
    align-content: start;
    font-size: 16px;
  }

  @media (max-width: 1000px) {
    .feed,
    .rc-note {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .msg {
      grid-template-columns: 9ch 1fr auto;
      row-gap: 4px;
    }

    .text {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
