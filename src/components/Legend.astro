---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const items = [
  { cls: 'st-best', name: 'Session best', meaning: 'my strongest work' },
  { cls: 'st-latest', name: 'Personal best', meaning: 'latest' },
  { cls: 'st-wip', name: 'In progress', meaning: 'still building' },
  { cls: 'st-team', name: 'In pit', meaning: 'team project' },
  { cls: 'st-alert', name: 'Race control', meaning: 'security event' },
];
---

<dl class:list={['legend', { compact }]} aria-label="Status colour legend">
  {
    items.map((i) => (
      <div class:list={['item', i.cls]}>
        <dt>
          <span class="dot" aria-hidden="true" />
          {i.name}
        </dt>
        <dd>{i.meaning}</dd>
      </div>
    ))
  }
</dl>

<style>
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  dt {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
  }

  dd {
    margin: 0;
    color: var(--muted);
  }

  dd::before {
    content: '· ';
  }

  .st-alert {
    --st: var(--red);
  }

  .compact dd {
    display: none;
  }
</style>
