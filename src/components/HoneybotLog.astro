---
// Honeybot's log: the (simulated) Cowrie feed as handwritten entries on lined paper.
import log from '../data/honeybot-log.json';
import Stamp from './marks/Stamp.astro';
import Tape from './marks/Tape.astro';

type Kind = 'incident' | 'investigation' | 'decision' | 'resolved';
const entries = log.events as { time: string; kind: Kind; message: string; outcome: string }[];
const simulated = log.source === 'sample';
---

<section class="hlog" aria-labelledby="hlog-title">
  <Tape class="hl-t1" seed={51} />
  <Tape class="hl-t2" seed={53} w={80} />
  <div class="hlog-head">
    <h2 id="hlog-title" class="head">Honeybot’s log</h2>
    <Stamp text={simulated ? 'SIMULATED' : 'REPLAYED'} color="pink" tilt={-6} seed={57} />
  </div>
  <p class="label">{simulated ? 'simulated · sample events' : 'replayed · anonymised Cowrie log, not live'}</p>
  <ol class="lines" aria-label="Honeypot events, newest first">
    {
      entries.map((e) => (
        <li class={`k-${e.kind}`} data-logentry>
          <time class="mono">{e.time}</time>
          <span class="kind mono">{e.kind}</span>
          <span class="msg hand">{e.message.toLowerCase()}</span>
          <span class="out mono">{e.outcome.toLowerCase()}</span>
        </li>
      ))
    }
  </ol>
  <p class="foot hand">
    these are the kind of events the Cowrie honeypot logs. auto-label all of them as attacks and retrain, and whoever sends them is writing
    your training data.
  </p>
</section>

<style>
  .hlog {
    position: relative;
    margin: 72px 0 0;
    padding: 28px clamp(18px, 3vw, 36px) 32px;
    background: #f2eee4;
    color: #26201a;
    max-width: 760px;
    rotate: -0.6deg;
  }

  .hlog :global(.hl-t1) {
    top: -14px;
    left: 40px;
    rotate: -5deg;
  }

  .hlog :global(.hl-t2) {
    top: -12px;
    right: 60px;
    rotate: 6deg;
  }

  .hlog-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  h2 {
    font-size: clamp(28px, 3vw, 40px);
    color: #16110c;
  }

  .label {
    color: #6b6158;
  }

  .lines {
    margin-top: 16px;
    background-image: repeating-linear-gradient(to bottom, transparent 0 39px, rgba(30, 60, 140, 0.22) 39px 40px);
    border-left: 2px solid rgba(220, 40, 90, 0.4);
    padding-left: 12px;
  }

  li {
    display: grid;
    grid-template-columns: 8ch 13ch 1fr auto;
    gap: 10px;
    align-items: baseline;
    min-height: 40px;
    padding-top: 9px;
  }

  time,
  .kind,
  .out {
    font-size: 12px;
    color: #6b6158;
  }

  .kind {
    text-transform: uppercase;
  }

  .k-incident .kind {
    color: #b0005a;
  }

  .k-decision .kind,
  .k-resolved .kind {
    color: #006b3a;
  }

  .msg {
    font-size: 21px;
    line-height: 1.1;
    color: #16110c;
  }

  .foot {
    margin-top: 18px;
    font-size: 20px;
    color: #3a322a;
    max-width: 52ch;
  }

  @media (max-width: 640px) {
    li {
      grid-template-columns: 8ch 1fr;
    }
    .msg {
      grid-column: 1 / -1;
    }
  }
</style>
