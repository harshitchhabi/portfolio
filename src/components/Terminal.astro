---
import { getProjects } from '../lib/projects';

const projects = (await getProjects()).map((p) => ({
  pos: p.data.pos,
  code: p.data.code,
  slug: p.id,
  title: p.data.title,
}));
---

<div class="term" role="dialog" aria-modal="true" aria-labelledby="term-title" hidden data-terminal data-projects={JSON.stringify(projects)}>
  <div class="term-bar">
    <p id="term-title" class="label">~ harshit@pitwall · type help</p>
    <button type="button" class="term-close label" data-terminal-close aria-label="Close terminal">Esc ×</button>
  </div>
  <div class="term-out" role="log" aria-live="polite" aria-relevant="additions" data-terminal-out></div>
  <form class="term-in" data-terminal-form autocomplete="off">
    <label for="term-input" class="prompt">$</label>
    <input
      id="term-input"
      type="text"
      spellcheck="false"
      autocapitalize="off"
      autocomplete="off"
      enterkeyhint="send"
      aria-describedby="term-title"
      data-terminal-input
    />
  </form>
</div>

<style>
  .term {
    position: fixed;
    left: var(--margin);
    right: var(--margin);
    bottom: 0;
    z-index: 60;
    max-width: 920px;
    margin-inline: auto;
    height: min(52vh, 460px);
    display: grid;
    grid-template-rows: auto 1fr auto;
    background: var(--bg);
    border: 1px solid var(--text);
    border-bottom: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .term[hidden] {
    display: none;
  }

  .term-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 14px;
    border-bottom: 1px solid var(--line);
  }

  .term-close:hover {
    color: var(--text);
  }

  .term-out {
    overflow-y: auto;
    padding: 12px 14px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    line-height: 1.6;
  }

  .term-out :global(.cmd) {
    color: var(--muted);
  }

  .term-out :global(.ok) {
    color: var(--green);
  }

  .term-out :global(.bad) {
    color: var(--red);
  }

  .term-out :global(.dim) {
    color: var(--muted);
  }

  .term-in {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 10px 14px 14px;
    border-top: 1px solid var(--line);
  }

  .prompt {
    color: var(--timing);
  }

  .term-in input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    color: var(--text);
    font: inherit;
    font-size: 16px;
    padding: 4px 0;
    outline: none;
    caret-color: var(--timing);
  }

  .term-in:focus-within {
    border-bottom: 2px solid var(--timing);
    padding-bottom: 12px;
  }
</style>
