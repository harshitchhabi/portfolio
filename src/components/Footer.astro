---
import Legend from './Legend.astro';
const year = new Date().getFullYear();
---

<footer class="footer wrap">
  <div class="legend-row">
    <p class="label">Legend</p>
    <Legend />
  </div>
  <div class="meta label">
    <span>© {year} Harshit Chhabi</span>
    <span>Self-hosted fonts · no trackers · press ~ for a terminal</span>
    <a href="/.well-known/security.txt">security.txt</a>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(96px, 12vw, 200px);
    border-top: 1px solid var(--line);
    padding-block: 24px 40px;
    display: grid;
    gap: 24px;
  }

  .legend-row {
    display: flex;
    gap: 24px;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
  }

  .meta a {
    color: var(--muted);
  }

  .meta a:hover {
    color: var(--text);
  }
</style>
