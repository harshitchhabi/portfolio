---
interface Entry {
  date: string;
  stage: 'Main floor' | 'Room 2' | 'Closing';
  title: string;
  where: string;
  text?: string;
  link?: { href: string; label: string };
}

const entries: Entry[] = [
  {
    date: '2026 – now',
    stage: 'Main floor',
    title: 'Technical Head',
    where: 'Dream Merchants Club, VIT Vellore',
    text: 'I build the platforms the club runs its events on.',
    link: { href: '/projects/dream-merchants', label: 'Dream Merchants case study' },
  },
  {
    date: '2026',
    stage: 'Closing',
    title: 'Smart India Hackathon 2026',
    where: 'Extending Vayu Rakshak',
    link: { href: '/projects/vayu-rakshak', label: 'Vayu Rakshak case study' },
  },
  {
    date: '2026',
    stage: 'Room 2',
    title: 'Bharatiya Antariksh Hackathon 2026',
    where: 'Team GEMs',
    text: 'Built Vayu Rakshak.',
  },
  {
    date: '2026',
    stage: 'Room 2',
    title: 'SQL (Intermediate)',
    where: 'HackerRank',
  },
  {
    date: 'May – Jul 2025',
    stage: 'Main floor',
    title: 'Cybersecurity Analyst Intern',
    where: 'State Bank of India, Global IT Centre',
    text: 'Web and application security testing, access control validation and threat analysis (VAPT). Applied encryption standards and secure coding in a regulated banking environment.',
    link: { href: '/projects/secure-file-hashing', label: 'Internship project: Secure File Hashing & Dual Encryption' },
  },
  {
    date: '2025',
    stage: 'Room 2',
    title: 'OCI 2025 Certified AI Foundations Associate',
    where: 'Oracle',
  },
  {
    date: '2024 – 2028',
    stage: 'Room 2',
    title: 'B.Tech CSE (Information Security)',
    where: 'VIT Vellore · CGPA 9.00',
  },
];
---

<section id="lineup" class="section wrap" aria-labelledby="lu-title">
  <div class="section-head">
    <h2 id="lu-title" class="display section-title">Lineup</h2>
    <p class="label">Main floor = work · Room 2 = study, certs, hackathons · Closing = now</p>
  </div>

  <ol class="lineup">
    {
      entries.map((e) => (
        <li class="entry" data-lineup-row id={e.title.includes('Analyst') ? 'sbi' : undefined}>
          <span class="rule" aria-hidden="true" />
          <p class="date">{e.date}</p>
          <p class:list={['stage', `s-${e.stage.replace(' ', '').toLowerCase()}`]}>{e.stage}</p>
          <div class="what">
            <h3 class="title">{e.title}</h3>
            <p class="where">{e.where}</p>
            {e.text && <p class="text">{e.text}</p>}
            {e.link && (
              <a class="link-mono" href={e.link.href}>
                {e.link.label} →
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .lineup {
    display: grid;
  }

  .entry {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 8px;
    padding-block: 22px 26px;
  }

  .rule {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: var(--line);
    transform-origin: left;
  }

  .entry:first-child .rule {
    background: var(--text);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .rule {
        animation: draw linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
    }
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .date {
    grid-column: 1 / span 2;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding-top: 0.5em;
  }

  .stage {
    grid-column: 3 / span 2;
    align-self: start;
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 3px 8px;
    margin-top: 0.5em;
    border: 1px solid var(--line);
    color: var(--muted);
  }

  .s-mainfloor {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }

  .s-closing {
    border-color: var(--text);
    color: var(--text);
  }

  .what {
    grid-column: 5 / span 8;
    display: grid;
    gap: 6px;
    justify-items: start;
  }

  .title {
    font-family: var(--font-display);
    font-weight: 850;
    font-variation-settings: 'wdth' 125;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 0.95;
    font-size: clamp(24px, 3.4vw, 54px);
  }

  .where {
    font-family: var(--font-mono);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .text {
    max-width: 60ch;
    margin-top: 6px;
  }

  .what .link-mono {
    margin-top: 10px;
  }

  @media (max-width: 760px) {
    .date {
      grid-column: 1 / span 2;
      padding-top: 0;
    }

    .stage {
      grid-column: 3 / span 2;
      justify-self: end;
      margin-top: 0;
    }

    .what {
      grid-column: 1 / -1;
      margin-top: 8px;
    }
  }
</style>
