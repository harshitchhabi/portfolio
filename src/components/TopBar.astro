---
const nav = [
  { href: '/#leaderboard', label: 'Leaderboard' },
  { href: '/#race-control', label: 'Race control' },
  { href: '/#lineup', label: 'Lineup' },
  { href: '/#box-box', label: 'Box box' },
];
---

<header class="bar">
  <div class="bar-inner wrap">
    <a class="mono-logo" href="/" aria-label="HC, Harshit Chhabi home">HC</a>

    <nav aria-label="Sections">
      <ul>
        {
          nav.map((n, i) => (
            <li>
              {i > 0 && <span class="sep" aria-hidden="true">·</span>}
              <a href={n.href}>{n.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="clock">
      <span class="sr-only">My local time in India:</span>
      <span class="clock-tag" aria-hidden="true">IST</span>
      <time data-clock>--:--:--</time>
    </p>

    <div class="controls">
      <button type="button" data-theme-toggle>
        <span data-theme-label>Theme</span>
      </button>
      <button type="button" data-audio-toggle aria-pressed="false" title="128 BPM, made in your browser">
        Audio: <span data-audio-label>Off</span>
      </button>
      <button type="button" class="term-btn" data-terminal-open aria-label="~ open terminal" title="Terminal (press ~)" aria-haspopup="dialog">~</button>
    </div>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }

  .bar-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: var(--bar-h);
  }

  .mono-logo {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 125;
    font-weight: 900;
    font-size: 18px;
    letter-spacing: -0.02em;
    text-decoration: none;
    padding: 4px 8px;
    background: var(--text);
    color: var(--bg);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 10px;
  }

  nav li {
    display: flex;
    gap: 10px;
  }

  nav a,
  .controls button {
    text-decoration: none;
    color: var(--muted);
    transition: color var(--t-fast) linear;
  }

  nav a:hover,
  .controls button:hover {
    color: var(--text);
  }

  .sep {
    color: var(--line);
  }

  .clock {
    margin-left: auto;
    display: flex;
    gap: 8px;
    color: var(--timing);
  }

  .clock-tag {
    color: var(--muted);
  }

  .controls {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .controls button {
    text-transform: uppercase;
    letter-spacing: inherit;
    font-size: inherit;
    padding: 6px 0;
  }

  .controls button[aria-pressed='true'] {
    color: var(--timing);
  }

  .controls button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .term-btn {
    border: 1px solid var(--line) !important;
    padding: 2px 8px !important;
    font-size: 14px !important;
  }

  @media (max-width: 960px) {
    .bar-inner {
      flex-wrap: wrap;
      gap: 8px 16px;
      padding-block: 8px;
    }

    nav {
      order: 5;
      width: 100%;
    }
  }

  @media (max-width: 420px) {
    .clock-tag {
      display: none;
    }

    .controls {
      gap: 12px;
    }
  }
</style>
