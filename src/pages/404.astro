---
import Base from '../layouts/Base.astro';
import { getProjects, projectHref } from '../lib/projects';

const projects = await getProjects();
---

<Base title="DNF · Page not found · Harshit Chhabi" description="This page retired from the race.">
  <section class="dnf wrap">
    <p class="label flag">Race control · Incident</p>
    <h1 class="display big">DNF</h1>
    <p class="display sub">Page not found</p>
    <p class="why">This page retired on lap one. The link might be old, or there's a typo in the address.</p>
    <p class="links">
      <a class="link-mono" href="/">Back to the pit wall</a>
      <a class="link-mono" href="/#leaderboard">Leaderboard</a>
    </p>
    <ol class="mini label" aria-label="Projects">
      {
        projects.map((p) => (
          <li>
            <a href={projectHref(p)}>
              P{p.data.pos} {p.data.code}
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .dnf {
    padding-block: clamp(48px, 8vw, 128px) 0;
  }

  .flag {
    display: inline-block;
    color: var(--red);
    border: 1px solid currentColor;
    padding: 4px 8px;
  }

  .big {
    font-size: clamp(120px, 30vw, 460px);
    line-height: 0.8;
    margin-top: 24px;
    margin-left: -0.05em;
  }

  .sub {
    font-size: clamp(28px, 5vw, 72px);
    margin-top: 12px;
  }

  .why {
    max-width: 44ch;
    margin-top: 32px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    margin-top: 28px;
  }

  .mini {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 56px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .mini a {
    color: var(--muted);
  }

  .mini a:hover {
    color: var(--text);
  }
</style>
