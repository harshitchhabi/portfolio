---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Station from '../components/Station.astro';
import Logbook from '../components/Logbook.astro';
import Toolbox from '../components/Toolbox.astro';
import Basement from '../components/Basement.astro';
import Jar from '../components/Jar.astro';
import SkipList from '../components/SkipList.astro';
import { getProjects } from '../lib/projects';

const projects = await getProjects();
---

<Base
  page="home"
  title="Harshit Chhabi · Daemons"
  description="I build security tools, ML systems and real-time platforms. Information Security student at VIT Vellore."
>
  <canvas class="floor" aria-hidden="true"></canvas>
  <SkipList />
  <Hero />
  <div id="work" class="show-only">
    <h2 class="sr-only">Projects</h2>
    {projects.map((p, i) => <Station project={p} index={i} />)}
  </div>
  <Logbook />
  <Toolbox />
  <Basement />
  <Jar />

</Base>

<style>
  .floor {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    display: block;
    pointer-events: none;
    opacity: 0;
    transition: opacity 600ms linear;
  }

  :global(html[data-floor='on']:not([data-mode='skip'])) .floor {
    opacity: 1;
  }

  /* Skip the show: only the plain list, the logbook and contact remain. */
  :global(html[data-mode='skip']) .floor,
  :global(html[data-mode='skip'] #hero),
  :global(html[data-mode='skip'] #work),
  :global(html[data-mode='skip'] #basement) {
    display: none;
  }
</style>
