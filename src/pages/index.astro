---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Station from '../components/Station.astro';
import { getProjects } from '../lib/projects';

const projects = await getProjects();
---

<Base
  title="Harshit Chhabi · Daemons"
  description="I build security tools, ML systems and real-time platforms. Information Security student at VIT Vellore."
>
  <canvas class="floor" aria-hidden="true"></canvas>
  <Hero />
  <div id="work">
    <h2 class="sr-only">Projects</h2>
    {projects.map((p, i) => <Station project={p} index={i} />)}
  </div>

  <section id="logbook" class="stop wrap"><h2 class="head">Logbook</h2></section>
  <section id="basement" class="stop wrap"><h2 class="head">The Basement</h2></section>
  <section id="contact" class="stop wrap"><h2 class="head">The Jar</h2></section>

  <script>
    import '../scripts/home';
  </script>
</Base>

<style>
  .floor {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    display: block;
    pointer-events: none;
    opacity: 0;
    transition: opacity 600ms linear;
  }

  :global(html[data-floor='on']) .floor {
    opacity: 1;
  }

  .stop {
    position: relative;
    z-index: 1;
    min-height: 100vh;
  }
</style>
