---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Daemon from '../../components/Daemon.astro';
import Stamp from '../../components/marks/Stamp.astro';
import RegMark from '../../components/marks/RegMark.astro';
import Doodle from '../../components/marks/Doodle.astro';
import Note from '../../components/marks/Note.astro';
import Metric from '../../components/marks/Metric.astro';
import Shot from '../../components/Shot.astro';
import HoneybotLog from '../../components/HoneybotLog.astro';
import { getProjects, projectHref, shortUrl, type Project } from '../../lib/projects';
import { STATION } from '../../data/stations';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.data.slug },
    props: { project, prev: projects[i - 1] ?? null, next: projects[i + 1] ?? null },
  }));
}

interface Props {
  project: Project;
  prev: Project | null;
  next: Project | null;
}

const { project, prev, next } = Astro.props;
const d = project.data;
const x = STATION[d.slug];
const { Content } = await render(project);
const meta = [d.role, d.team, d.year, d.stack.join(' / ')];
---

<Base page="case" title={`${d.title} · Harshit Chhabi`} description={d.oneLiner}>
  <article class="case wrap">
    <a href="/#work" class="back-btn mono" data-back data-cursor="inspect">← back</a>
    <RegMark class="reg r1" seed={5} />
    <RegMark class="reg r2" seed={8} />
    <Doodle kind={x.doodle} class="cd" seed={33} />

    <header class="head-grid">
      <div class="vignette" data-near-react>
        <Daemon id={x.daemon} pose="idle" poses={['idle', 'react', 'action']} size="lg" eager />
        <Note arrow="up" color="pink" seed={77} class="v-note">{d.daemon}, pid {d.pid}</Note>
      </div>
      <div class="titles">
        <p class="label">daemon #{d.order} · the file on {d.daemon.toLowerCase()}</p>
        <h1 class="display title" data-vt-title={d.slug} data-redact>{d.title}</h1>
        <p class="meta mono">
          {meta.map((m) => <span>{m} · </span>)}
          {d.platforms.length === 0 && (d.repoPrivate ? <span>private repo</span> : <a href={d.repo} rel="noopener">{shortUrl(d.repo)} ↗</a>)}
          {d.platforms.map((pl, i) => <>{i > 0 && ' · '}<a href={pl.repo} rel="noopener">{pl.name} ↗</a></>)}
          {d.live && <> · <a href={d.live} rel="noopener">live ↗</a></>}
        </p>
        <p class="oneliner">{d.oneLiner}</p>
        <Stamp text={d.stamp} color="stamp" tilt={-9} seed={81} class="case-stamp" />
      </div>
    </header>

    {
      d.metrics.length > 0 && (
        <div class="metrics">
          {d.metrics.map((m, i) => (
            <Metric value={m.value} label={m.label} seed={90 + i} />
          ))}
        </div>
      )
    }

    <div class="body prose">
      <Content />
    </div>

    {d.slug === 'ids' && <HoneybotLog />}

    <Shot project={project} />
    {d.shots.map((s, i) => <Shot project={project} src={s.src} alt={s.alt} flip={i % 2 === 0} />)}

    <nav class="pn" aria-label="Other daemons">
      {
        prev ? (
          <a href={projectHref(prev)} class="pn-link case-link">
            <img src={`/characters/${STATION[prev.data.slug].daemon}/idle-still.svg`} alt="" width="256" height="256" loading="lazy" />
            <span class="label">← previous daemon</span>
            <span class="hand">{prev.data.daemon}</span>
          </a>
        ) : (
          <a href="/#station-1" class="pn-link">
            <span class="label">← back to</span>
            <span class="hand">the server floor</span>
          </a>
        )
      }
      {
        next ? (
          <a href={projectHref(next)} class="pn-link next case-link">
            <img src={`/characters/${STATION[next.data.slug].daemon}/idle-still.svg`} alt="" width="256" height="256" loading="lazy" />
            <span class="label">next daemon →</span>
            <span class="hand">{next.data.daemon}</span>
          </a>
        ) : (
          <a href="/#logbook" class="pn-link next">
            <span class="label">on to →</span>
            <span class="hand">the logbook</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .case {
    position: relative;
    padding-top: calc(var(--nav-h) + 48px);
    padding-bottom: 96px;
    max-width: 1180px;
    margin-inline: auto;
  }

  /* stays in reach while you read; goes back where you came from (scripts/anchors.ts) */
  .back-btn {
    position: sticky;
    top: calc(var(--nav-h) + 10px);
    z-index: 5;
    display: inline-block;
    margin-bottom: 18px;
    padding: 6px 12px;
    border: 1px dashed var(--ink-dim);
    background: var(--paper);
    color: var(--ink);
    font-size: 14px;
    text-decoration: none;
  }

  .back-btn:hover,
  .back-btn:focus-visible {
    color: var(--riso-pink);
    border-color: var(--riso-pink);
  }

  .case :global(.reg) {
    position: absolute;
  }
  .case :global(.r1) {
    top: calc(var(--nav-h) + 10px);
    left: 6px;
  }
  .case :global(.r2) {
    top: 60vh;
    right: 6px;
  }
  .case :global(.cd) {
    right: 2%;
    top: 92vh;
  }

  .head-grid {
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 56px);
    align-items: center;
  }

  .vignette {
    position: relative;
    display: grid;
    justify-items: center;
  }

  .vignette :global(.v-note) {
    margin-top: -8px;
    /* reserve the room so the handwriting font arriving late can't shift the page */
    height: 112px;
    line-height: 1.1;
  }

  .titles {
    position: relative;
  }

  .title {
    margin-top: 10px;
    font-size: clamp(38px, 5.8vw, 82px);
    line-height: 0.95;
    max-width: 16ch;
    view-transition-name: project-title;
  }

  .meta {
    margin-top: 18px;
    font-size: 13px;
    color: var(--ink-dim);
    line-height: 1.7;
  }

  .oneliner {
    margin-top: 18px;
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.35;
    max-width: 36ch;
  }

  .titles :global(.case-stamp) {
    position: absolute;
    right: 0;
    top: -36px;
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin: 48px 0 0 clamp(0px, 8vw, 120px);
  }

  .body {
    margin: 56px auto 0;
    max-width: 68ch;
  }

  .body :global(h2) {
    font-family: var(--font-head);
    font-size: clamp(30px, 3.4vw, 46px);
    margin-top: 64px;
    line-height: 1.05;
  }

  .body :global(h2:first-child) {
    margin-top: 0;
  }

  .body :global(.h-line) {
    display: block;
    color: var(--riso-pink);
    margin: 6px 0 18px;
    overflow: visible;
  }

  .body :global(h3) {
    font-family: var(--font-hand);
    font-weight: 400;
    font-size: 32px;
    color: var(--riso-green);
    margin: 30px 0 6px;
  }

  .body :global(ul) {
    margin: 14px 0 0;
  }

  .body :global(li) {
    position: relative;
    padding-left: 1.4em;
    margin-top: 8px;
  }

  .body :global(li::before) {
    content: '✗';
    position: absolute;
    left: 0;
    color: var(--riso-pink);
    font-family: var(--font-hand);
  }

  .body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .body :global(.diagram) {
    margin: 40px 0 8px;
    width: min(1100px, calc(100vw - 2 * var(--margin)));
    position: relative;
    left: 50%;
    translate: -50% 0;
    overflow: visible;
  }

  .body :global(.dg) {
    display: block;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
    color: var(--ink);
    overflow: visible;
  }

  .body :global(.dg-v) {
    display: none;
    max-width: 360px;
  }

  @media (max-width: 860px) {
    .body :global(.dg-h) {
      display: none;
    }
    .body :global(.dg-v) {
      display: block;
    }
  }

  .body :global(.dg-t) {
    font-family: var(--font-hand);
    font-size: 19px;
    fill: var(--ink);
  }

  .body :global(.dg-label) {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    fill: var(--ink-dim);
  }

  .body :global(.dg-node.dg-alert),
  .body :global(.dg-t.dg-alert) {
    color: var(--riso-pink);
    fill: var(--riso-pink);
  }

  .body :global(.dg-node.dg-best),
  .body :global(.dg-t.dg-best) {
    color: var(--riso-green);
    fill: var(--riso-green);
  }

  .body :global(.dg-node.dg-wip),
  .body :global(.dg-t.dg-wip) {
    color: var(--ink-dim);
    fill: var(--ink-dim);
  }

  .body :global(.dg-arrow) {
    color: var(--ink-dim);
  }

  .body :global(.diagram figcaption) {
    margin-top: 12px;
    text-align: center;
    font-size: 20px;
    color: var(--ink-dim);
  }

  .pn {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 96px;
  }

  .pn-link {
    display: grid;
    justify-items: start;
    gap: 2px;
    text-decoration: none;
  }

  .pn-link.next {
    justify-items: end;
    text-align: right;
  }

  .pn-link img {
    width: 120px;
    height: 120px;
  }

  .pn-link .hand {
    font-size: 30px;
  }

  @media (max-width: 760px) {
    .head-grid {
      grid-template-columns: 1fr;
    }
    .titles :global(.case-stamp) {
      top: -10px;
    }
  }
</style>
