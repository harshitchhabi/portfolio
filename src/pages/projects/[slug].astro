---
// Plain case-study page until Phase 4 brings the daemon vignette, diagrams and tape.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects, projectHref, shortUrl, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.data.slug },
    props: { project, prev: projects[i - 1] ?? null, next: projects[i + 1] ?? null },
  }));
}

interface Props {
  project: Project;
  prev: Project | null;
  next: Project | null;
}

const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
---

<Base title={`${d.title} · Harshit Chhabi`} description={d.oneLiner}>
  <article class="case wrap">
    <p class="label">daemon #{d.order} · {d.daemon} · pid {d.pid}</p>
    <h1 class="head title">{d.title}</h1>
    <p class="meta mono">
      {d.role} · {d.team} · {d.year} · {d.stack.join(' / ')} · <a href={d.repo} rel="noopener">{shortUrl(d.repo)} ↗</a>
      {d.live && <> · <a href={d.live} rel="noopener">live ↗</a></>}
    </p>
    <div class="prose body">
      <Content />
    </div>
    <nav class="pn mono" aria-label="Other daemons">
      {prev ? <a href={projectHref(prev)}>← {prev.data.daemon}</a> : <span />}
      {next ? <a href={projectHref(next)}>{next.data.daemon} →</a> : <a href="/#work">all daemons →</a>}
    </nav>
  </article>
</Base>

<style>
  .case {
    padding-top: calc(var(--nav-h) + 64px);
    padding-bottom: 96px;
  }

  .title {
    font-size: clamp(36px, 6vw, 84px);
    max-width: 18ch;
    margin-top: 12px;
  }

  .meta {
    margin-top: 20px;
    font-size: 13px;
    color: var(--ink-dim);
  }

  .body {
    margin-top: 48px;
  }

  .body :global(h2) {
    font-family: var(--font-head);
    font-size: clamp(26px, 3vw, 38px);
    margin: 48px 0 16px;
  }

  .body :global(h3) {
    font-family: var(--font-head);
    font-size: 24px;
    margin: 28px 0 10px;
  }

  .body :global(li) {
    margin-top: 6px;
  }

  .pn {
    display: flex;
    justify-content: space-between;
    margin-top: 80px;
  }
</style>
